# Apache SPA fallback and caching hints.
#
# 1. Rewrite every non-file, non-directory request to index.html so deep links work on a hard
#    refresh. The -f test skips requests that already resolve to a real file, so hashed assets
#    under /assets are served normally instead of being swallowed by the rewrite.
# 2. Hashed build output can be cached forever, because the filename changes whenever the content
#    does. index.html must NOT be cached, or browsers would keep booting a stale app shell that
#    references deleted asset hashes.
# 3. Compression is a server capability, so it is requested here rather than assumed.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ /index.html [L]
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain
  AddOutputFilterByType DEFLATE application/javascript application/json image/svg+xml
</IfModule>
