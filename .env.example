# Copy to `.env.local` and fill in from the Firebase console:
# Project settings → Your apps → Web app → SDK setup and configuration → Config.
# Leave every value blank to run the app without Firebase (the UI falls back to a local demo session).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
