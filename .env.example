# Environment configuration for the Quantelis workspace dashboard.
#
# Copy to `.env.local` and fill in. Every variable here is prefixed with VITE_, which means Vite
# inlines its value into the JavaScript bundle at build time. That has one consequence worth
# stating plainly:
#
#   NOTHING IN THIS FILE IS A SECRET. A VITE_ variable is visible to anyone who loads the app.
#
# Firebase web config values (API key, auth domain, project id, storage bucket) are designed to be
# public — they identify the project, they do not grant access. What actually protects the data is
# Firebase Authentication settings, the Security Rules for Firestore and Cloud Storage, and the
# authorised-domains list in the Firebase console. Do not put a service-account private key, a
# database password, or any admin credential in a VITE_ variable: it would be published.

# ---------------------------------------------------------------------------
# Backend / API
# ---------------------------------------------------------------------------
# Base URL of the Laravel API once it exists. Leave blank to use the bundled mock data layer.
VITE_API_BASE_URL=

# 'mock'  - use the local mock data and mock auth adapters (no backend needed)
# 'live'  - call VITE_API_BASE_URL and let the backend be the source of truth
VITE_AUTH_MODE=mock

# Whether the app is allowed to generate and use local mock data. In a live deployment set this
# to false so demo datasets, teammates and forecast runs can never appear.
VITE_USE_MOCK_DATA=true

# ---------------------------------------------------------------------------
# Firebase (optional — only needed for VITE_AUTH_MODE=live)
# ---------------------------------------------------------------------------
# Firebase console -> Project settings -> Your apps -> Web app -> SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# Google sign-in
# ---------------------------------------------------------------------------
# OAuth 2.0 client ID from Google Cloud console -> APIs & Services -> Credentials.
# Do NOT commit a real value, and do not reuse the Firebase web config here — they are different
# credentials. Leave blank to hide the Google button. See README for the authorised-origins setup.
VITE_GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------------
# Optional integrations — all inert when blank
# ---------------------------------------------------------------------------
# Analytics measurement/tag ID. Nothing is sent unless this is set AND consent has been granted.
VITE_ANALYTICS_ID=

# CAPTCHA (Cloudflare Turnstile site key, or a reCAPTCHA v3 site key). When blank the forms
# submit without a CAPTCHA challenge rather than breaking.
VITE_CAPTCHA_SITE_KEY=
